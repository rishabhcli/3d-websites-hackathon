{
  "name": "3d-websites-hackathon",
  "version": "0.0.0",
  "private": true,
  "description": "Production implementation of a multi-view anamorphic sculpture gallery.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "pnpm run typecheck && vite build && node scripts/check-build.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run boundaries:check && pnpm run deadcode:check",
    "lint": "eslint . --max-warnings 0 && stylelint 'src/**/*.css' --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --force --pretty false",
    "boundaries:check": "node scripts/check-boundaries.mjs && depcruise src --config .dependency-cruiser.cjs --output-type err",
    "deadcode:check": "knip",
    "test": "node scripts/run-tests.mjs --coverage",
    "test:property": "vitest run tests/property",
    "test:integration": "node scripts/run-tests.mjs tests/integration",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "eval": "node scripts/evidence/generate-tier0.mjs",
    "evidence:generate": "node scripts/evidence/generate-tier0.mjs",
    "dependency-review:refresh": "node scripts/evidence/refresh-dependency-review.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.7 --sbom-type application --prod --out .dev/reports/sbom.cdx.json && node scripts/check-sbom.mjs",
    "dev": "pnpm run dev:up",
    "dev:test-server:foreground": "node scripts/foreground-service.mjs --kind dev --port 4102 --service projection-harness",
    "dev:evidence-server:foreground": "node scripts/evidence-server.mjs --port 4103 --service evidence-server",
    "dev:preflight": "node scripts/dev-preflight.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:health": "node scripts/dev-health.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "verify-all": "node scripts/verify-all.mjs",
    "release-check": "pnpm run verify-all"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.182.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
