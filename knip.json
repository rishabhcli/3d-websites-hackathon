{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.mjs",
    "src/**/*.test.{ts,tsx}",
    "tests/**/*.ts",
    "vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.{ts,mjs}"],
  "ignoreDependencies": ["@fontsource-variable/archivo", "@fontsource-variable/newsreader"],
  "ignoreExportsUsedInFile": true,
  "vite": false
}
